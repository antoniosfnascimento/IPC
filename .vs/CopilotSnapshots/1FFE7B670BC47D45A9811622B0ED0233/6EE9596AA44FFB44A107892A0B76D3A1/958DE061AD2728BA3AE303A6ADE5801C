# Adicionar node ao PATH da sessão atual se necessário, para que a execução do script não falhe
$nodePath = "C:\Program Files\nodejs"
if (Test-Path $nodePath) {
    if ($env:PATH -notmatch [regex]::Escape($nodePath)) {
        $env:PATH += ";$nodePath"
    }
}

if (-not (Get-Command "python" -ErrorAction SilentlyContinue)) {
    Write-Error "O Python não está instalado ou configurado no PATH."
    exit 1
}

# Usar npm.cmd para evitar problemas com Execution Policies que bloqueiam ficheiros .ps1
$npmCmd = if (Get-Command "npm.cmd" -ErrorAction SilentlyContinue) { "npm.cmd" } else { "npm" }

if (-not (Get-Command $npmCmd -ErrorAction SilentlyContinue)) {
    Write-Error "O Node.js (npm) não está instalado ou configurado no PATH."
    exit 1
}

Push-Location backend

if (-not (Test-Path "venv")) {
    Write-Host "A criar ambiente virtual e a instalar dependências no backend..."
    python -m venv venv
}

$pythonExe = ".\venv\Scripts\python.exe"

& $pythonExe -m pip install --upgrade pip | Out-Null
& $pythonExe -m pip install -r requirements.txt | Out-Null

Write-Host "A iniciar backend na porta 8000..."
# Janela visível para não deixar processos escondidos que bloqueiem a porta 8000 depois
Start-Process $pythonExe -ArgumentList "-m uvicorn main:app --reload --port 8000"

Pop-Location

Push-Location frontend

if (-not (Test-Path "node_modules")) {
    Write-Host "A instalar dependências do frontend..."
    & $npmCmd install
}

Write-Host "A iniciar frontend..."
& $npmCmd run dev

Pop-Location
